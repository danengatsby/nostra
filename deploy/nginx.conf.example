# Configurație nginx pentru Nostradamus. Înlocuiește DOMENIU.RO, apoi:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/nostra
#   sudo ln -s /etc/nginx/sites-available/nostra /etc/nginx/sites-enabled/nostra
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d DOMENIU.RO -d www.DOMENIU.RO     # certificatul HTTPS

# Limita de cereri noi de previziune per IP (a doua barieră, pe lângă limitele din aplicație).
limit_req_zone $binary_remote_addr zone=nostra_predict:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name DOMENIU.RO www.DOMENIU.RO;
    client_max_body_size 16k;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Cererile noi de previziune: cel mult ~6 pe minut de la același IP, apoi 429.
    location = /api/predict {
        limit_req zone=nostra_predict burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fluxul de progres (Server-Sent Events): fără buffer și cu timeout lung, o previziune durează minute.
    location ~ ^/api/predict/[^/]+/events$ {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
