# Copiază acest fișier ca .env și completează cheia API.

# Cheia de la https://platform.claude.com (Settings → API keys). Obligatorie în producție.
ANTHROPIC_API_KEY=

# 1 = rezultate simulate, fără apeluri API (pentru probe). În producție: 0.
DEMO_MODE=0

# Adresa publică a site-ului (pentru linkurile și imaginile de previzualizare)
BASE_URL=https://nostradamus.my

PORT=3200
HOST=127.0.0.1

# Previziunea gratuită nu cere email (1 = o cere din nou, doar pentru validare). Analiza plătită cere mereu adresa.
FREE_SCREEN_EMAIL_REQUIRED=0
# Modelul previziunii gratuite: lite = modelul rapid, din FALLBACK_DAILY_USD (implicit);
# main = modelul principal cât permite DAILY_BUDGET_USD, apoi modelul rapid (vechiul comportament).
FREE_TIER=lite
# Efortul analizei aprofundate plătite (modelul principal): low | medium | high
PAID_EFFORT=high

# --- Oracolul ---
ORACLE_MODEL=claude-opus-5-5
# Efortul selectat implicit în formular: low | medium | high (vizitatorul îl poate schimba la fiecare cerere)
ORACLE_EFFORT=medium
# Câte căutări / pagini citite are voie să facă la o previziune
ORACLE_MAX_SEARCHES=12
ORACLE_MAX_FETCHES=4
# 1 = dacă modelul refuză din motive de siguranță, cererea e reîncercată automat pe un model de rezervă
ORACLE_FALLBACKS=1

# --- Limite (controlul costurilor) ---
# Cât se poate cheltui pe zi (zi UTC), în dolari, pe modelul principal în afara comenzilor plătite: verificări
# și, cu FREE_TIER=main, previziuni gratuite. Comenzile plătite nu depind de el. 0 = fără limită în dolari.
DAILY_BUDGET_USD=1
# Bugetul zilnic al modelului rapid Claude Haiku 5.5 (~0,05 $ / previziune): previziunile gratuite și preluarea
# celor gratuite când modelul principal nu răspunde. Când se epuizează, gratuitul se reia a doua zi.
FALLBACK_DAILY_USD=1
# Câte căutări face modelul rapid la o previziune
FALLBACK_MAX_SEARCHES=5
# Partea din bugetul zilnic pe care o pot folosi verificările previziunilor ajunse la termen (~0,10 $ / previziune)
VERIFY_DAILY_USD=0.25
# 0 = oprește verificarea automată
VERIFY_ENABLED=1
# Previziuni noi pe oră de la același vizitator
RATE_PER_HOUR=6
# Inițieri de checkout pe oră de la același IP (implicit RATE_PER_HOUR)
# CHECKOUT_PER_HOUR=6
# Previziuni noi pe zi, în total
DAILY_LIMIT=300
# Câte previziuni rulează simultan (restul stau la rând)
MAX_CONCURRENT=3
MAX_QUEUE=20
# 1 = o cerere identică primește rezultatul deja calculat. Durata depinde de perioadă:
# 3 ore pentru o săptămână … 7 zile pentru 5–10 ani (lib/catalog.js). 0 = fără cache.
CACHE_ENABLED=1
JOB_TIMEOUT_MS=480000

# Contul pentru pagina de statistici /admin. Se creează / se schimbă cu `npm run admin-cont`, care scrie aici
# utilizatorul și amprenta parolei (nu parola). Fără cont și fără ADMIN_EMAILS, pagina este dezactivată.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Variantă veche, acceptată doar când lipsește ADMIN_PASSWORD_HASH: parola în clar.
# ADMIN_PASSWORD=

# --- Plata (Stripe Checkout) ---
# Cheia secretă din Stripe (Developers → API keys): sk_live_… (sau sk_test_… pentru probe).
# Cât timp e goală, previziunile sunt gratuite.
STRIPE_SECRET_KEY=
# Opțional: semnătura webhook-ului https://nostradamus.my/api/stripe/webhook (evenimentele
# checkout.session.completed și checkout.session.async_payment_succeeded). Fără el, plățile se confirmă
# la întoarcerea vizitatorului și printr-o verificare la 2 minute.
STRIPE_WEBHOOK_SECRET=
# Prețul analizei aprofundate, în cenți de euro
PRICE_EUR_CENTS=299

# --- Jurnalul accesărilor (tabelul „Accesări” din /admin) ---
# Baza DB-IP Lite City (format .mmdb) pentru locația aproximativă a IP-urilor, calculată pe server. Pe acest server
# se folosește baza Astrohoroscop, actualizată lunar de astro-geoip.timer. Fără bază, locația apare „Necunoscută”.
GEOIP_CITY_DB=/var/www/astro/data/geoip-city.mmdb
GEOIP_DB=/var/www/astro/data/geoip-country.mmdb

# --- Emailuri (linkul raportului după plată). Gmail: parolă de aplicație. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nostradamus <adresa@exemplu.ro>

# --- Firma (pagina de termeni, emailuri) ---
COMPANY_NAME=
COMPANY_CUI=
CONTACT_EMAIL=

# Adresele care pot cere pe email linkul de acces la statistici (separate prin virgulă)
ADMIN_EMAILS=
