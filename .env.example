# Copiază acest fișier ca .env și completează cheia API.

# Cheia de la https://platform.claude.com (Settings → API keys). Obligatorie în producție.
ANTHROPIC_API_KEY=

# 1 = rezultate simulate, fără apeluri API (pentru probe). În producție: 0.
DEMO_MODE=0

# Adresa publică a site-ului (pentru linkurile și imaginile de previzualizare)
BASE_URL=https://nostradamus.my

PORT=3200
HOST=127.0.0.1

# --- Oracolul ---
ORACLE_MODEL=claude-opus-5-5
# Efortul selectat implicit în formular: low | medium | high (vizitatorul îl poate schimba la fiecare cerere)
ORACLE_EFFORT=medium
# Câte căutări / pagini citite are voie să facă la o previziune
ORACLE_MAX_SEARCHES=12
ORACLE_MAX_FETCHES=4
# 1 = dacă modelul refuză din motive de siguranță, cererea e reîncercată automat pe un model de rezervă
ORACLE_FALLBACKS=1

# --- Limite (controlul costurilor) ---
# Cât se poate cheltui pe zi (zi UTC), în dolari. Când bugetul e atins, oracolul nu mai pornește previziuni
# noi până a doua zi; cele deja făcute rămân vizibile. 0 = fără limită în dolari.
DAILY_BUDGET_USD=1
# Partea din bugetul zilnic pe care o pot folosi verificările previziunilor ajunse la termen (~0,10 $ / previziune)
VERIFY_DAILY_USD=0.25
# 0 = oprește verificarea automată
VERIFY_ENABLED=1
# Previziuni noi pe oră de la același vizitator
RATE_PER_HOUR=6
# Previziuni noi pe zi, în total
DAILY_LIMIT=300
# Câte previziuni rulează simultan (restul stau la rând)
MAX_CONCURRENT=3
MAX_QUEUE=20
# 1 = o cerere identică primește rezultatul deja calculat. Durata depinde de perioadă:
# 3 ore pentru o săptămână … 7 zile pentru 5–10 ani (lib/catalog.js). 0 = fără cache.
CACHE_ENABLED=1
JOB_TIMEOUT_MS=480000

# Parola pentru pagina de administrare /admin (orice nume de utilizator). Goală = pagina dezactivată.
ADMIN_PASSWORD=

# --- Plata (Stripe Checkout) ---
# Cheia secretă din Stripe (Developers → API keys): sk_live_… (sau sk_test_… pentru probe).
# Cât timp e goală, previziunile sunt gratuite.
STRIPE_SECRET_KEY=
# Opțional: semnătura webhook-ului https://nostradamus.my/api/stripe/webhook (evenimentele
# checkout.session.completed și checkout.session.async_payment_succeeded). Fără el, plățile se confirmă
# la întoarcerea vizitatorului și printr-o verificare la 2 minute.
STRIPE_WEBHOOK_SECRET=
# Prețul unei previziuni, în cenți de euro
PRICE_EUR_CENTS=100
